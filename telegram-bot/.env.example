# Get token from @BotFather — never commit the real token
TELEGRAM_BOT_TOKEN=

# Optional: path to departments config (default: ./departments.json)
# DEPARTMENTS_CONFIG=./departments.json

# PDF uploader (upload-bot.js)
# Your numeric Telegram user id (message @userinfobot). Comma-separated for multiple admins.
ADMIN_TELEGRAM_IDS=

# Set to 1 to auto-append uploads into departments.json
# UPLOAD_AUTO_SAVE=1
