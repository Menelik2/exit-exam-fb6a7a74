# Copy to .env and fill in locally. Do NOT commit .env.
# On Vercel, set these as project environment variables (Production + Preview).

# Required for AI question generation (or paste a key in the app UI):
GEMINI_API_KEY=

# Admin dashboard (/admin)
# Password checked on the server (not in the browser):
ADMIN_PASSWORD=
# Optional stronger signing secret for admin session tokens:
# ADMIN_SESSION_SECRET=

# Required to SAVE department/PDF catalog from Admin (writes telegram-bot/departments.json):
# Create a GitHub personal access token with Contents: Read and Write on this repo.
ADMIN_GITHUB_TOKEN=
# Optional overrides (defaults: Menelik2 / exit-exam-fb6a7a74 / main):
# GITHUB_OWNER=Menelik2
# GITHUB_REPO=exit-exam-fb6a7a74
# GITHUB_BRANCH=main

# Optional — only if you enable Supabase auth later:
# SUPABASE_PROJECT_ID=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# VITE_SUPABASE_PROJECT_ID=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
